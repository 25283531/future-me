# 未来我 backend — copy to .env and fill in. NEVER commit a real .env.
# All keys are server-side only; the Android app never sees them.

# --- auth signing secret (REQUIRED in prod: long random string) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- LLM providers for letter generation (OpenAI-compatible /chat/completions) ---
# At least ONE provider key is required for POST /letters/generate; without
# any key it returns 503. Default provider: LLM_PROVIDER (default qwen).
# Switch providers by setting LLM_PROVIDER, or per request with
# POST /letters/generate {"provider": "zhipu"}. See GET /llm/providers.
# LLM_PROVIDER=qwen

# qwen （千问，默认）: DashScope API key from Alibaba Cloud Model Studio
# (same key as Qwen3-TTS below). 按量付费，充 100 元先用。
DASHSCOPE_API_KEY=
# QWEN_LLM_MODEL=qwen-plus

# hunyuan （腾讯混元）: API key from the Hunyuan console
# (api.hunyuan.cloud.tencent.com). 按量付费。
HUNYUAN_API_KEY=
# HUNYUAN_MODEL=hunyuan-turbos-latest

# siliconflow （硅基流动）: API key from siliconflow.cn. 按量付费，注册有赠金。
SILICONFLOW_API_KEY=
# SILICONFLOW_MODEL=Qwen/Qwen3-8B

# zhipu （智谱 GLM): API key from bigmodel.cn (same key as GLM-TTS below).
# 按量付费，支付宝/微信充值，余额永久有效。
ZHISHU_API_KEY=
# ZHISHU_MODEL=glm-4-flash

# generic （通用接口）: any OpenAI-compatible endpoint. All three required.
# GENERIC_LLM_BASE_URL=https://your-llm-gateway.example.com/v1
# GENERIC_LLM_API_KEY=
# GENERIC_LLM_MODEL=

# --- TTS providers (at least one paid key recommended; Edge TTS is the free fallback) ---
# Qwen3-TTS-Flash (primary): uses DASHSCOPE_API_KEY above (same key as 千问 LLM).
# QWEN_MODEL=qwen3-tts-flash

# Zhipu GLM-TTS: uses ZHISHU_API_KEY above (same key as 智谱 GLM LLM).

# Tencent Cloud TTS (premium voices): SecretId/SecretKey from the Tencent console.
# Premium voices are billed postpaid (0.3 CNY/10k chars) once postpaid is enabled;
# no resource pack purchase is required.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# TENCENT_REGION=ap-guangzhou

# --- membership (phase 1: free, everything unlocked) ---
# TRIAL_DAYS=7
# PRICE_MONTHLY_CNY=9.9

# --- data directory (Docker: /app/data via volume) ---
# DATA_DIR=./data
